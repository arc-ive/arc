# Arc — Development Environment

# This file contains variable names and safe development placeholders only.
# Never put real credentials, tokens, passwords, certificates, or secrets here.

# Application
APP_ENV=development

# Structured application logging (Observability foundation, TRD 28).
# stdlib logging only; every line carries the correlation ID. Allowed
# values: DEBUG, INFO, WARNING, ERROR, CRITICAL (anything else falls
# back to INFO). Log content is safe metadata only - correlation id,
# method, route template, status, duration, coarse error category.
# Never bodies, prompts, answers, tokens, credentials, secrets, PII,
# or raw query strings.
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://arc:arc-dev-password@localhost:5432/arc
POSTGRES_DB=arc
POSTGRES_USER=arc
POSTGRES_PASSWORD=arc-dev-password

# AI gateway
OPENROUTER_API_KEY=

# AI routing layer
OMNIROUTE_BASE_URL=

# Authentication (X-11) — JWT bearer authentication for the simulated
# development environment. The secret must be set; a missing or too-short
# value fails closed (protected endpoints deny). Use a development-only
# placeholder locally; never a production secret.
JWT_SECRET=arc-dev-jwt-secret-change-me-please-32chars
JWT_ISSUER=arc
JWT_AUDIENCE=arc-api
JWT_EXPIRY_SECONDS=3600

# Application role assignments (X-11 development configuration, NOT persisted
# and NOT derived from tenant membership roles). JSON object mapping user IDs
# to application roles:
#   platform_administrator | company_administrator | operations_user | employee
# Unassigned users are denied by default.
#
# Reference environment users:
#   ref-platform-admin          -> platform_administrator
#   ref-acme-*-company-admin    -> company_administrator
#   ref-acme-*-ops-user         -> operations_user
#   ref-acme-*-employee-1       -> employee
#   ref-acme-*-employee-2       -> employee
#   (same pattern for nova, vertex, northstar)
APPLICATION_ROLE_ASSIGNMENTS={"ref-platform-admin": "platform_administrator", "ref-acme-technologies-company-admin": "company_administrator", "ref-acme-technologies-ops-user": "operations_user", "ref-acme-technologies-employee-1": "employee", "ref-acme-technologies-employee-2": "employee", "ref-nova-systems-company-admin": "company_administrator", "ref-nova-systems-ops-user": "operations_user", "ref-nova-systems-employee-1": "employee", "ref-nova-systems-employee-2": "employee", "ref-vertex-solutions-company-admin": "company_administrator", "ref-vertex-solutions-ops-user": "operations_user", "ref-vertex-solutions-employee-1": "employee", "ref-vertex-solutions-employee-2": "employee", "ref-northstar-digital-company-admin": "company_administrator", "ref-northstar-digital-ops-user": "operations_user", "ref-northstar-digital-employee-1": "employee", "ref-northstar-digital-employee-2": "employee"}

# Google OIDC authentication (X-11 production authentication).
# Obtain credentials from Google Cloud Console:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Add authorized redirect URI: http://localhost:5173/api/auth/callback
# Leave empty to disable Google OIDC (falls back to JWT-only authentication).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Session management (server-side sessions for Google OIDC).
# Sessions are stored in PostgreSQL and managed via HttpOnly cookies.
SESSION_EXPIRY_HOURS=24

# Connector provider integrations (PRD 22, TRD 33, ADR-002).
#
# Connector credentials are read lazily from this environment variable as a
# JSON object mapping tenant IDs to provider tokens:
#   {"<tenant-id>": {"github": "<token>", "slack": "<token>", "linear": "<token>"}}
# Keep this empty in development; the simulated provider mode does not need
# credentials. Use safe placeholders only, never real tokens. Unknown
# providers or malformed JSON fail closed.
CONNECTOR_CREDENTIALS={}

# Provider mode for the code-defined connector catalog: "simulated" (default,
# deterministic controlled/fake clients per TRD 33) or "live" (httpx adapters
# against real provider APIs). Live mode is NOT authorized by ADR-002.
CONNECTOR_PROVIDER_MODE=simulated

# Webhook ingestion endpoints (PRD 16, TRD 16, ADR-001 webhook security
# boundary). JSON object keyed by endpoint ID; each entry binds exactly one
# ingestion endpoint to one tenant and carries its HMAC-SHA256 signing secret:
#   {"<endpoint-id>": {"tenant_id": "<tenant-id>", "secret": "<placeholder>"}}
# Signing secrets must be at least 16 characters. Keep this empty in
# development (no ingestion endpoints exist until configured); use safe
# development placeholders only, never real secrets. Malformed JSON or weak
# secrets fail closed. Secrets are never logged, returned, or persisted.
WEBHOOK_INGESTION_ENDPOINTS={}

# Embeddings (Secure RAG) — provider configuration is environment-driven.
# Supported providers:
#   deterministic — local, deterministic word-hash provider (development/tests)
#   openai — production OpenAI text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-local
# Must match the storage dimension (vector(1536) in schema.sql). Changing the
# storage dimension requires a schema migration (deferred decision).
EMBEDDING_DIMENSION=1536

# OpenAI embedding provider (when EMBEDDING_PROVIDER=openai).
# Required for the openai provider. Never committed, logged, or returned.
# When routing through OmniRoute/OpenRouter, the gateway manages this credential.
OPENAI_API_KEY=

# Unified Intelligence (LLM) — provider configuration is environment-driven.
# The deterministic provider is the only currently supported provider; it is
# for development and tests only, NOT a production model. The LLM is NOT the
# authorization system: it receives only the Approved Context (sanitized
# content + citation references). A production provider (OpenRouter is the
# primary configurable AI provider per TRD 34; the exact model is a deferred
# decision) is not silently substituted; unknown values fail closed at startup.
LLM_PROVIDER=deterministic
LLM_MODEL=deterministic-local

# Add variables only when they are actually required.
